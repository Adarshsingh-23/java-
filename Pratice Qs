// grading  system //
 
 let marks = "100";

 if(marks >= 100){
    console.log("A+ grade ");
 }
 else if( marks >= 80){
    console.log*(" A grade")
 }
 else if( marks >= 70){
    console.log*(" B+ grade")
 }
 else if( marks >= 60){
    console.log*(" B grade")
 }
 else if( marks >= 50){
    console.log*(" C+ grade")
 }
 else if( marks >= 40){
    console.log*(" C grade")
 }
 else ( marks <= 30){
    console.log*(" D grade")
 }
 
